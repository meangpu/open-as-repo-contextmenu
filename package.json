{
  "name": "open-as-git-repo",
  "displayName": "Open As Git Repository",
  "description": "Right-click a folder in Explorer to open it as a Git repository",
  "version": "0.0.9",
  "publisher": "meangpu",
  "icon": "icon/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/meangpu/open-as-repo-contextmenu"
  },
  "main": "./extension.js",
  "scripts": {
    "release": "node -e \"require('fs').readdirSync('.').filter(f => f.endsWith('.vsix')).forEach(f => require('fs').unlinkSync(f))\" && vsce package patch"
  },
  "contributes": {
    "commands": [
      {
        "command": "openAsGitRepo.run",
        "title": "Open as Git Repository"
      },
      {
        "command": "openOnGitHub.run",
        "title": "Open on GitHub"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "openAsGitRepo.run",
          "when": "explorerResourceIsFolder",
          "group": "navigation@1"
        },
        {
          "command": "openOnGitHub.run",
          "group": "navigation@2"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "openAsGitRepo.run",
          "when": "scmProvider == git",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "openOnGitHub.run",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "openAsGitRepo.run",
        "key": "alt+shift+e",
        "when": "filesExplorerFocus && !inputFocus"
      },
      {
        "command": "openAsGitRepo.run",
        "key": "alt+shift+e",
        "when": "focusedView == workbench.scm && !inputFocus",
        "args": {
          "fromScm": true
        }
      }
    ]
  }
}
